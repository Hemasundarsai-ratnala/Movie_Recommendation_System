{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://movie-recommendation-system-i8o4.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://movie-recommendation-system-i8o4.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://movie-recommendation-system-i8o4.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
